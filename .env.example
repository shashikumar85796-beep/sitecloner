# Password for the whole app (browser login prompt; username can be anything).
# STRONGLY recommended - without it anyone with your Vercel URL can use the tool.
APP_PASSWORD=change-me

# Activity history database. Easiest: Vercel Dashboard -> Storage / Marketplace -> Upstash Redis.
# It injects KV_REST_API_URL + KV_REST_API_TOKEN automatically. (UPSTASH_REDIS_REST_URL/TOKEN also work.)
# Without this, history is only kept in your browser (localStorage).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: render JavaScript-heavy sites (React/Next/Vue) through Browserless.io
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io

# Optional limits
# CLONE_MAX_SECONDS=270   # keep below your plan's function duration (Hobby max = 300s)
# CLONE_MAX_MB=120        # total size cap per clone
# CLONE_MAX_PAGES=100     # hard cap for "max pages"

# LOCAL TESTING ONLY: allow cloning localhost / private IPs (never set this on Vercel)
# ALLOW_PRIVATE=1
